{
  "manifest_version": 3,
  "name": "kan2sci",
  "version": "3.1.0",
  "description": "Snippets inteligentes com sincronização automática + criação de Solicitações SCI direto do Kanboard - equipe SCI.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://www.s1991.com.br/*",
    "https://kanboard.sci.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/utils.js",
        "lib/yaml-parser.js",
        "content/content-assistant.js",
        "content/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["https://kanboard.sci.com.br/*"],
      "js": [
        "content/kanboard-request.js"
      ],
      "css": [
        "content/kanboard-request.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "kan2sci",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}